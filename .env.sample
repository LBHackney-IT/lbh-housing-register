# Client Sentry (inlined at build). Use a non-deploy stage (e.g. localdev) to keep it off.
NEXT_PUBLIC_ENV=localdev
# Server/edge Sentry (runtime). Unset/non-deploy keeps it off locally.
# SENTRY_ENVIRONMENT=localdev
NEXT_PUBLIC_NAME=Housing Register
NEXT_PUBLIC_VERSION=$npm_package_version
NEXT_PUBLIC_GTM_ID=GTM-XXXXXX

EVIDENCE_STORE_URL=des-value

# Staff sign in (Cognito confidential client; all values are server-only)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
COGNITO_ISSUER=https://cognito-idp.eu-west-2.amazonaws.com/eu-west-2_EXAMPLE
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://example.auth.eu-west-2.amazoncognito.com

# Dedicated native Cognito user/app client for LOCAL_E2E staff integration.
# The app client must be public (no client secret) and allow USER_PASSWORD_AUTH.
# Keep these server-side: Cypress reads them only in its Node task and never
# exposes them to browser code.
COGNITO_E2E_CLIENT_ID=
COGNITO_E2E_USERNAME=
COGNITO_E2E_PASSWORD=

# Test group carried by the dedicated Cognito E2E user. Additive to
# AUTHORISED_MANAGER_GROUP so real claims keep working, and only honoured
# while LOCAL_E2E=true outside a deployment. Never set this in a deployed
# environment.
# E2E_AUTHORISED_MANAGER_GROUP=

# Resident email OTP (not staff authentication).
# Cypress resident cookies are signed with a hardcoded dummy secret, not this.
# HACKNEY_JWT_SECRET is required only when SKIP_VERIFY_TOKEN is false.
SKIP_VERIFY_TOKEN=true
HACKNEY_JWT_SECRET=

# Testing locally with cypress it's best to use a unique var for groups. Value is not important.
# AUTHORISED_ADMIN_GROUP=admin-group
# AUTHORISED_MANAGER_GROUP=manager-group
# AUTHORISED_OFFICER_GROUP=officer-group
# AUTHORISED_READONLY_GROUP=read-only-group

# If testing locally against your own token best to use a value you already have in your group token.
# AUTHORISED_ADMIN_GROUP=
# AUTHORISED_MANAGER_GROUP=
# AUTHORISED_OFFICER_GROUP=
# AUTHORISED_READONLY_GROUP=

# Housing Register API
HOUSING_REGISTER_API=http://localhost:3910/api/v1/
HOUSING_REGISTER_KEY=testing

# Address Lookup API
LOOKUP_API_URL=
LOOKUP_API_TOKEN=

# GOVUK Notify
NOTIFY_API_KEY=testing
NOTIFY_TEMPLATE_NEW_APPLICATION=
NOTIFY_TEMPLATE_DISQUALIFY=
NOTIFY_TEMPLATE_MEDICAL_NEED=

# Activity History API
ACTIVITY_HISTORY_API=http://localhost:3600/api/v1

# Enable the three /api/e2e/* Nock-control routes in the Next.js process.
# Required for mocked E2E only; leave unset for LOCAL_E2E with real APIs.
E2E_HTTP_MOCKS=
